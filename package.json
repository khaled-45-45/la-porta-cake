{
  "name": "la-porta-cake",
  "version": "0.0.0",
  "private": true,
  "description": "La Porta Cake: public storefront (V1), with admin and API planned for V2.",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=12.23.0 <13.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @la-porta/storefront dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@la-porta/config": "workspace:*",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
