# Dependencies
node_modules/

# Build output
.next/
out/
dist/
build/

# Tests and reports
coverage/
playwright-report/
test-results/
blob-report/
.lighthouseci/

# Environment (only .env.example is committed)
.env
.env.*
!.env.example

# Deployment
.vercel/

# Logs and OS files
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Editors and local tool settings
.vscode/*
!.vscode/extensions.json
.idea/
.claude/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Images awaiting the owner's approval stay local and out of Git (decisions 0006 and 0010).
# Only the manifest is tracked. Ignoring the folder's contents (not the folder itself)
# lets Git keep tracking the manifest.
/private-assets/review/*
!/private-assets/review/manifest.json
