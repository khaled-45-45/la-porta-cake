# Normalise line endings in the repository; keep binary files untouched.
* text=auto eol=lf

*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.avif binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary

# Font licences are kept exactly as published upstream (the SIL OFL text has a trailing
# space), so whitespace checks skip them.
OFL.txt -whitespace
